{
  "display": {
    "color": {
      "keys": "#ffffff"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "#67b0e8"
    },
    "type": "small"
  },
  "modules": [
    {
      "format": "{pretty-name}",
      "key": " os",
      "keyColor": "#71b7ff",
      "type": "os"
    },
    {
      "key": " kernel",
      "keyColor": "#d2a8ff",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}FX",
      "key": " wm",
      "keyColor": "#ff8a8a",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": " shell",
      "keyColor": "#8ddb8c",
      "type": "shell"
    },
    {
      "key": " uptime",
      "keyColor": "#d2b45f",
      "type": "uptime"
    },
    {
      "format": "{name} {7}",
      "key": " cpu",
      "keyColor": "cyan",
      "type": "cpu"
    },
    {
      "format": "",
      "key": " gpu",
      "keyColor": "magenta",
      "type": "gpu"
    },
    {
      "format": "{used} / {total}",
      "key": " ram",
      "keyColor": "#71b7ff",
      "type": "memory"
    },
    {
      "format": "{name} {size-used} / {size-total} {size-percentage}",
      "key": " disk",
      "keyColor": "yellow",
      "type": "disk"
    },
    {
      "format": "{pretty-name}",
      "key": " color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
}
